# =========================================================================
#                    Mr. Biology Project Git Ignore Configuration
# =========================================================================

# -------------------------------------------------------------------------
# 1. Dependency Directories
# -------------------------------------------------------------------------
# Ignore external libraries and node dependencies installed locally
node_modules/
jspm_packages/
web_modules/

# -------------------------------------------------------------------------
# 2. Build & Compilations Outputs
# -------------------------------------------------------------------------
# Ignore production builds, SSR bundles, and preview servers
dist/
dist-ssr/
build/
out/
.vercel/

# TypeScript build files
*.tsbuildinfo

# Vite specific build/cache directory
.vite/

# -------------------------------------------------------------------------
# 3. Environment Variables & Sensitive Keys (SECURITY CRITICAL)
# -------------------------------------------------------------------------
# Do NOT commit raw API keys, staging URLs, or secrets to the repo!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.local

# Certificate and encryption key files
*.pem
*.key
*.cert
*.pfx
*.p12

# -------------------------------------------------------------------------
# 4. Logs and Diagnostic Outputs
# -------------------------------------------------------------------------
# Ignore various package manager debug logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic tools & report profiles
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# -------------------------------------------------------------------------
# 5. IDE / Editor Configurations
# -------------------------------------------------------------------------
# Ignore workspace configs for popular editors while retaining shared recommendations

# VS Code specific directories
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# IntelliJ / WebStorm IDE files
.idea/
*.iws
*.iml
*.ipr

# Other editors (Sublime, Vim, Eclipse)
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.classpath
.settings/

# -------------------------------------------------------------------------
# 6. Operating System Specific Files
# -------------------------------------------------------------------------
# macOS artifacts
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.Trashes
VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows artifacts
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]ownload/
Desktop.ini
$RECYCLE.BIN/
*.lnk

# -------------------------------------------------------------------------
# 7. Testing & Coverage Outputs
# -------------------------------------------------------------------------
# Ignore files generated by test runners (Vitest, Jest, Cypress)
coverage/
.nyc_output/
.playwright/
html-report/
junit.xml

# -------------------------------------------------------------------------
# 8. Temporary Files & Caches
# -------------------------------------------------------------------------
# Ignore system buffers and package manager caches
.npm/
.eslintcache
.stylelintcache
.prettiercache
.cache/
.sass-cache/
tmp/
temp/
